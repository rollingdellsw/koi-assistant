{
  "llm": {
    "provider": "llamacpp",
    "apiKey": "${VLLM_API_KEY}",
    "model": "Qwen3.8-27B-Q8",
    "contextWindow": 262144,
    "baseUrl": "https://vllm.rollingdell.com/v1",
    "temperature": 1.0,
    "topP": 0.95,
    "maxTokens": 61440,
    "thinking": {
      "enabled": true,
      "budgetLevel": "high",
      "fallbackToPrompt": false
    }
  },
  "executor": {
    "model": "Qwen3.8-27B-Q8",
    "enabled": true,
    "timeoutMs": 180000,
    "maxIterations": 20
  },
  "tools": {
    "whitelist": [
      "runSubtask"
    ]
  },
  "agent": {
    "systemPrompt": "You are a web assistant with browser use tools.\n\n"
  },
  "storage": {
    "maxSessionStorageMb": 1000,
    "autoCleanupDays": 90
  },
  "skills": {
    "preload": [
    ],
    "comment": "Preload skills make their tools available immediately without LLM calling readSkill"
  },
  "gateways": {
    "default": {
      "authMethod": "none",
      "url": "ws://localhost:8080"
    }
  },
  "defaultGateway": "default"
}
