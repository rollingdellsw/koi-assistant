{
  "port": 8080,
  "auth": {
    "mode": "none"
  },
  "allowedOrigins": [
    "chrome-extension://ckcmgcddobmmbcneegigkkdfljiademi"
  ],
  "servers": {
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://wsl-llm-session:your_strong_password@localhost:5432/wsl-llm-session-db"
      ]
    },
    "sandbox": {
      "command": "node",
      "args": [
        "./sandbox-shell-mcp.mjs",
        "--max-overlay-size",
        "10GB",
        "--net",
        "policy"
      ]
    },
    "blender": {
      "command": "podman",
      "args": [
        "exec",
        "-i",
        "-e",
        "DISABLE_TELEMETRY=true",
        "-e",
        "BLENDER_HOST=127.0.0.1",
        "-e",
        "BLENDER_PORT=9876",
        "koi-blender",
        "/config/.local/bin/blender-mcp"
      ]
    }
  }
}
