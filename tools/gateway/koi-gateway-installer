#!/usr/bin/env bash
#
# koi-gateway-installer — install/manage the Koi Gateway as a systemd user service (Linux)
#                         or LaunchAgent (macOS).
#
# The end-user interface is just:
#     ./koi-gateway-installer            # install + enable + start (no editing)
#     systemctl --user status koi-gateway (Linux) / launchctl list com.koi.gateway (macOS)
#
# The installer resolves the gateway directory and your Node (Homebrew/fnm/nvm/system)
# itself and configures the background service. Override Node detection with
# KOI_NODE_BIN=/abs/path ./koi-gateway-installer
#
set -euo pipefail

SERVICE_NAME="koi-gateway"
UNIT="${SERVICE_NAME}.service"
OS="${KOI_FORCE_OS:-$(uname -s)}"

# Portable script directory resolver (works on Linux, macOS, BSD without GNU readlink -f)
resolve_script_dir() {
  local target="$1"
  while [ -L "$target" ]; do
    local dir
    dir="$(cd -P "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    [ "${target#/}" = "$target" ] && target="$dir/$target"
  done
  cd -P "$(dirname "$target")" && pwd
}

resolve_abs_path() {
  local target="$1"
  if [ -e "$target" ]; then
    local dir; dir="$(cd -P "$(dirname "$target")" 2>/dev/null && pwd)"
    printf '%s/%s\n' "$dir" "$(basename "$target")"
  else
    printf '%s\n' "$target"
  fi
}

GATEWAY_DIR="$(resolve_script_dir "$0")"
WRAPPER="${GATEWAY_DIR}/run-gateway.sh"
ENTRY="${GATEWAY_DIR}/koi-gateway.js"
CONFIG="${GATEWAY_DIR}/gateway-config.json"
EXCLUDE_FILE="${KOI_EXCLUDE_FILE:-${GATEWAY_DIR}/sandbox-exclude.default}"
DOCS_REL="${GATEWAY_DIR}/../../docs/skill_api.md"

# --- network egress policy (--net policy) ----------------------------------
# The allowlist is deployment policy in the same sense as sandbox-exclude.default,
# but unlike the exclude list it is NOT flattened into the unit: it seeds a JSON
# policy file that the approval dialog then mutates at runtime, so it has to
# outlive the unit and survive re-running this installer.
NET_ALLOW_FILE="${KOI_NETWORK_ALLOW:-${GATEWAY_DIR}/koi-network-allow.default}"
KOI_HOME_DIR="${KOI_HOME:-$HOME/.koi}"
NET_POLICY_FILE="${KOI_NETWORK_POLICY:-${KOI_HOME_DIR}/network-policy.json}"
NET_SOCK="${KOI_NETWORK_SOCK:-${KOI_HOME_DIR}/approval.sock}"
NET_SETUP="${GATEWAY_DIR}/koi-net-setup.sh"
NET_POLICY_LIB="${GATEWAY_DIR}/koi-net-policy.mjs"
# Not 3128: that is the distro squid default, and colliding with a running
# system squid costs both the port and squid's shared-memory namespace.
PROXY_PORT="${KOI_PROXY_PORT:-3129}"

# The egress proxy is a SEPARATE service from the gateway on purpose: it must
# survive a gateway restart (otherwise every restart drops approvals that are
# mid-flight), and it is the piece a user may legitimately stop on its own.
PROXY_SERVICE="koi-egress"
PROXY_UNIT="${PROXY_SERVICE}.service"
PROXY_LAUNCHD_LABEL="com.koi.egress"

# Linux systemd definitions
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT_PATH="${UNIT_DIR}/${UNIT}"
PROXY_UNIT_PATH="${UNIT_DIR}/${PROXY_UNIT}"

# macOS launchd definitions
LAUNCHD_LABEL="com.koi.gateway"
LAUNCHD_DIR="$HOME/Library/LaunchAgents"
LAUNCHD_PLIST="${LAUNCHD_DIR}/${LAUNCHD_LABEL}.plist"
LAUNCHD_LOG_DIR="$HOME/Library/Logs"
LAUNCHD_LOG_PATH="${LAUNCHD_LOG_DIR}/koi-gateway.log"
PROXY_LAUNCHD_PLIST="${LAUNCHD_DIR}/${PROXY_LAUNCHD_LABEL}.plist"
PROXY_LOG_PATH="${LAUNCHD_LOG_DIR}/koi-egress.log"

c_reset='\033[0m'; c_b='\033[0;34m'; c_g='\033[0;32m'; c_y='\033[0;33m'; c_r='\033[0;31m'
info() { printf "${c_b}[INFO]${c_reset} %s\n" "$*"; }
ok()   { printf "${c_g}[ OK ]${c_reset} %s\n" "$*"; }
warn() { printf "${c_y}[WARN]${c_reset} %s\n" "$*" >&2; }
err()  { printf "${c_r}[FAIL]${c_reset} %s\n" "$*" >&2; }

# --- helpers ---------------------------------------------------------------

# Resolve a Node that will still exist under minimal service PATH. Deliberately
# skips ephemeral multishell paths. Returns "" if none found.
stable_node() {
  if [ -n "${KOI_NODE_BIN:-}" ] && [ -x "${KOI_NODE_BIN}" ]; then
    printf '%s\n' "${KOI_NODE_BIN}"; return 0
  fi
  local fnm_dir="${FNM_DIR:-$HOME/.local/share/fnm}"
  if [ -x "${fnm_dir}/aliases/default/bin/node" ]; then
    printf '%s\n' "${fnm_dir}/aliases/default/bin/node"; return 0
  fi
  local nvm_node
  nvm_node="$(ls -d "$HOME"/.nvm/versions/node/*/bin/node 2>/dev/null | sort -V | tail -1 || true)"
  if [ -n "${nvm_node}" ] && [ -x "${nvm_node}" ]; then
    printf '%s\n' "${nvm_node}"; return 0
  fi
  # Standard Homebrew (Apple Silicon + Intel) and system locations
  local c
  for c in /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
    [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  if command -v node >/dev/null 2>&1; then
    command -v node; return 0
  fi
  return 1
}

have_systemd_user() { systemctl --user show-environment >/dev/null 2>&1; }
have_launchd() { command -v launchctl >/dev/null 2>&1; }

# Can the gateway's one external import (`ws`) be resolved from GATEWAY_DIR?
# Probes through the ESM resolver — the same path koi-gateway.js takes at
# runtime — instead of testing for node_modules/ws, so a workspace-hoisted
# install counts as present.
deps_ok() {
  local node_bin="${1:-node}"
  ( cd "$GATEWAY_DIR" \
    && "$node_bin" --input-type=module -e \
       "import('ws').then(()=>process.exit(0)).catch(()=>process.exit(1))" \
       >/dev/null 2>&1 )
}

# Resolve dependencies at install time where npm and the user's PATH are available.
ensure_deps() {
  local node_bin="${1:-}"
  [ -n "$node_bin" ] || node_bin="node"
  if deps_ok "$node_bin"; then
    ok "Dependencies present ('ws' resolves from ${GATEWAY_DIR})"
    return 0
  fi

  local npm_bin=""
  [ -x "$(dirname "$node_bin")/npm" ] && npm_bin="$(dirname "$node_bin")/npm"
  [ -n "$npm_bin" ] || npm_bin="$(command -v npm || true)"
  if [ -z "$npm_bin" ]; then
    for c in /opt/homebrew/bin/npm /usr/local/bin/npm /usr/bin/npm; do
      [ -x "$c" ] && { npm_bin="$c"; break; }
    done
  fi

  if [ -z "$npm_bin" ]; then
    err "'ws' is not installed and no npm was found. Install it manually:"
    err "    cd ${GATEWAY_DIR} && npm i ws"
    return 1
  fi

  # koi-gateway.js is ESM. If this directory has no package.json, write a correct manifest first.
  if [ ! -f "${GATEWAY_DIR}/package.json" ]; then
    cat > "${GATEWAY_DIR}/package.json" <<'PKGEOF'
{
  "name": "koi-gateway",
  "private": true,
  "type": "module",
  "dependencies": {
    "ws": "^8.18.0"
  }
}
PKGEOF
    ok "Wrote ${GATEWAY_DIR}/package.json"
  fi

  info "Installing gateway dependencies in ${GATEWAY_DIR} ..."
  local pkg_act="i"
  ( cd "$GATEWAY_DIR" && PATH="$(dirname "$node_bin"):$PATH" \
      "$npm_bin" "$pkg_act" --no-audit --no-fund ) || true
  # An existing manifest that simply never listed `ws` needs it added.
  deps_ok "$node_bin" || ( cd "$GATEWAY_DIR" && PATH="$(dirname "$node_bin"):$PATH" \
      "$npm_bin" "$pkg_act" --no-audit --no-fund ws ) || true

  if ! deps_ok "$node_bin"; then
    err "'ws' still does not resolve after dependency setup — fix that before starting:"
    err "    cd ${GATEWAY_DIR} && npm i ws"
    return 1
  fi
  ok "Installed gateway dependencies"
}

# Flatten sandbox-exclude.default (one path per line, `#` comments, blank lines)
# into the single comma-separated value the sandbox server expects.
flatten_excludes() {
  if [ -n "${KOI_SANDBOX_EXCLUDE:-}" ]; then
    printf '%s' "${KOI_SANDBOX_EXCLUDE}"
    return 0
  fi
  [ -f "$EXCLUDE_FILE" ] || return 0
  sed 's/#.*//' "$EXCLUDE_FILE" \
    | tr -d ' \t' \
    | sed 's/\$HOME/~/g' \
    | grep -v '^$' \
    | paste -sd, - \
    || true
}

# Count entries in a flattened list.
exclude_count() {
  [ -n "${1:-}" ] || { printf '0'; return 0; }
  printf '%s' "$1" | tr ',' '\n' | grep -c . || true
}

# --- network egress helpers -------------------------------------------------

# Which --net mode gateway-config.json gives the sandbox server. Parsed with
# node rather than grep: the args array is JSON, and a regex over it silently
# reports the wrong mode the moment someone reformats the file.
net_mode() {
  local node_bin; node_bin="${1:-$(stable_node || command -v node || true)}"
  [ -n "$node_bin" ] && [ -f "$CONFIG" ] || { printf 'unknown'; return 0; }
  "$node_bin" -e '
    const fs = require("fs");
    try {
      const cfg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      const args = cfg?.servers?.sandbox?.args || [];
      const i = args.indexOf("--net");
      process.stdout.write(i >= 0 && args[i + 1] ? String(args[i + 1]) : "host");
    } catch { process.stdout.write("unknown"); }
  ' "$CONFIG" 2>/dev/null || printf 'unknown'
}

# Set --net MODE on the sandbox server in gateway-config.json. Idempotent,
# preserves every other key, and keeps a .bak of the pre-edit file.
set_net_mode() {
  local mode="$1" node_bin; node_bin="$(stable_node || command -v node || true)"
  [ -n "$node_bin" ] || { err "node not found; cannot edit ${CONFIG}"; return 1; }
  [ -f "$CONFIG" ] || { err "gateway-config.json not found at ${CONFIG}"; return 1; }
  "$node_bin" -e '
    const fs = require("fs");
    const [file, mode] = process.argv.slice(1);
    const cfg = JSON.parse(fs.readFileSync(file, "utf8"));
    const srv = cfg && cfg.servers && cfg.servers.sandbox;
    if (!srv) { console.error("no servers.sandbox entry in " + file); process.exit(1); }
    const args = Array.isArray(srv.args) ? srv.args.slice() : [];
    const i = args.indexOf("--net");
    if (i >= 0) args.splice(i, 2);
    if (mode !== "") args.push("--net", mode);
    srv.args = args;
    if (!fs.existsSync(file + ".bak")) fs.copyFileSync(file, file + ".bak");
    fs.writeFileSync(file, JSON.stringify(cfg, null, 2) + "\n");
  ' "$CONFIG" "$mode"
}

# Create ~/.koi/network-policy.json from koi-network-allow.default if absent.
# NEVER overwrites: after the first run that file belongs to the user and to
# the approval dialog, and clobbering it on reinstall would silently revoke
# every "always allow" they had granted.
seed_network_policy() {
  local node_bin; node_bin="$(stable_node || command -v node || true)"
  [ -n "$node_bin" ] || { warn "node not found; cannot seed ${NET_POLICY_FILE}"; return 1; }
  [ -f "$NET_POLICY_LIB" ] || { err "koi-net-policy.mjs not found at ${NET_POLICY_LIB}"; return 1; }
  if [ -f "$NET_POLICY_FILE" ]; then
    ok "Network policy already present: ${NET_POLICY_FILE} (left untouched)"
    return 0
  fi
  # Paths go through argv rather than string interpolation so a directory with
  # a space or a quote in it does not become a syntax error.
  "$node_bin" --input-type=module -e '
    const [lib, policyFile, allowFile] = process.argv.slice(1);
    const { ensurePolicy } = await import("file://" + lib);
    const p = ensurePolicy(policyFile, allowFile);
    console.log(`seeded ${p.rules.length} rule(s)`);
  ' "$NET_POLICY_LIB" "$NET_POLICY_FILE" "$NET_ALLOW_FILE" </dev/null &&
    ok "Seeded ${NET_POLICY_FILE} from $(basename "$NET_ALLOW_FILE")"
}

# The packages that make egress filtering possible. Nothing else in the
# gateway needs them, which is why they are not part of `install`.
have_cmd() { command -v "$1" >/dev/null 2>&1; }

# util-linux (setpriv) is core on every Linux distro, so it is only named when
# it is genuinely absent — listing it unconditionally would tell almost every
# user to install something they already have. It is not optional though:
# without setpriv (or capsh) confine cannot drop CAP_NET_ADMIN and refuses to
# run at all, because a filter the sandbox can `nft flush` is not a filter.
net_caps_pkg() {
  [ "$OS" = "Darwin" ] && return 0
  have_cmd setpriv || have_cmd capsh || printf ' util-linux'
}

net_packages() {
  if [ "$OS" = "Darwin" ]; then printf 'squid'
  else printf 'passt nftables squid%s' "$(net_caps_pkg)"; fi
}

net_install_cmd() {
  if [ "$OS" = "Darwin" ]; then
    have_cmd brew && printf 'brew install %s' "$(net_packages)"
  elif have_cmd apt-get; then
    printf 'sudo apt-get install -y %s' "$(net_packages)"
  elif have_cmd dnf; then
    printf 'sudo dnf install -y %s' "$(net_packages)"
  elif have_cmd pacman; then
    printf 'sudo pacman -S --needed %s' "$(net_packages)"
  elif have_cmd zypper; then
    printf 'sudo zypper install -y %s' "$(net_packages)"
  fi
}

# Offer to install what preflight says is missing, instead of printing a list
# and expecting the user to work out their package manager. KOI_ASSUME_YES=1
# skips the prompt (for scripted installs).
net_install_deps() {
  local cmd; cmd="$(net_install_cmd)"
  if [ -z "$cmd" ]; then
    err "Could not detect a package manager. Install these yourself: $(net_packages)"
    return 1
  fi
  echo
  info "Missing dependencies. This will run:"
  echo "    ${cmd}"
  if [ "${KOI_ASSUME_YES:-0}" != "1" ]; then
    printf '  Proceed? [Y/n] '
    local reply; read -r reply </dev/tty || reply="n"
    case "$reply" in [Nn]*) err "Skipped. Install them and re-run: $0 network on"; return 1 ;; esac
  fi
  # shellcheck disable=SC2086
  eval "$cmd" || { err "Package install failed. Run it by hand: ${cmd}"; return 1; }

  # Debian's squid package enables and starts a system squid on 3128. Ours runs
  # as the user on its own port with its own shared-memory namespace, so the two
  # coexist — but say so, because a running squid the user did not ask for is
  # alarming and looks like ours.
  if [ "$OS" != "Darwin" ] && systemctl is-active --quiet squid 2>/dev/null; then
    warn "Your distro started a system squid on port 3128. That is unrelated to Koi and"
    warn "can stay. If you do not want it: sudo systemctl disable --now squid"
  fi
  return 0
}

net_preflight() {
  chmod +x "$NET_SETUP" 2>/dev/null || true
  [ -f "$NET_SETUP" ] || { err "koi-net-setup.sh not found at ${NET_SETUP}"; return 1; }
  KOI_PROXY_PORT="$PROXY_PORT" bash "$NET_SETUP" preflight "$@"
}

# Pick a port nobody else holds unless the user pinned one. A port collision is
# the single most common way this setup fails, and it is not a decision worth
# asking anyone to make.
net_pick_port() {
  [ -n "${KOI_PROXY_PORT:-}" ] && return 0   # user pinned it; respect that
  local picked
  picked="$(KOI_PROXY_PORT="$PROXY_PORT" bash "$NET_SETUP" free-port 2>/dev/null || true)"
  if [ -n "$picked" ] && [ "$picked" != "$PROXY_PORT" ]; then
    info "Port ${PROXY_PORT} is taken; using ${picked} instead."
    PROXY_PORT="$picked"
  fi
}

# Prove the whole chain works before telling the sandbox to rely on it: squid is
# listening, the ACL helper answers, and the policy is being applied. A denied
# host must come back 403. Without this, a proxy that starts but cannot run its
# helper looks identical to success until the first sandbox command fails.
net_verify() {
  have_cmd curl || { warn "curl not found; skipping end-to-end proxy check"; return 0; }
  local code
  code="$(curl -s -o /dev/null -m 15 -w '%{http_code}' \
            -x "127.0.0.1:${PROXY_PORT}" "http://169.254.169.254/" 2>/dev/null || true)"
  case "$code" in
    403) ok "Proxy check: denied host correctly refused (HTTP 403)" ; return 0 ;;
    000) err "Proxy check: could not reach the proxy on 127.0.0.1:${PROXY_PORT}"; return 1 ;;
    *)   err "Proxy check: expected 403 for a denied host, got HTTP ${code}."
         err "  The policy helper is probably not running. Log: journalctl --user -u ${PROXY_SERVICE} -n 30"
         return 1 ;;
  esac
}

render_proxy_systemd_unit() {
  local node_bin="$1"
  cat <<EOF
# Generated by koi-gateway-installer on $(date -u +%Y-%m-%dT%H:%M:%SZ). Do not edit;
# re-run the installer to regenerate.
[Unit]
Description=Koi sandbox egress proxy (squid + network policy helper)
# The gateway must not come up before the proxy it depends on, and stopping the
# gateway should take the proxy with it — they are one feature, not two
# services. PartOf gives propagation of stop/restart; the gateway's Wants=/
# After= gives ordering and start-together. Kept as two units only because they are
# two long-lived processes with different failure modes; from the outside,
# `systemctl --user restart koi-gateway` now handles both.
Before=${UNIT}
PartOf=${UNIT}

[Service]
Type=simple
WorkingDirectory=${GATEWAY_DIR}
ExecStart=/bin/bash ${NET_SETUP} proxy
Environment=KOI_PROXY_PORT=${PROXY_PORT}
Environment=KOI_HOME=${KOI_HOME_DIR}
Environment=KOI_NETWORK_POLICY=${NET_POLICY_FILE}
Environment=KOI_NETWORK_SOCK=${NET_SOCK}
EOF
  [ -n "${node_bin}" ] && printf 'Environment=KOI_NODE_BIN=%s\n' "${node_bin}"
  cat <<'EOF'
Restart=on-failure
RestartSec=3
SyslogIdentifier=koi-egress

[Install]
WantedBy=default.target
EOF
}

render_proxy_launchd_plist() {
  local node_bin="$1"
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${PROXY_LAUNCHD_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>${NET_SETUP}</string>
        <string>proxy</string>
    </array>
    <key>WorkingDirectory</key>
    <string>${GATEWAY_DIR}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>KOI_PROXY_PORT</key>
        <string>${PROXY_PORT}</string>
        <key>KOI_HOME</key>
        <string>${KOI_HOME_DIR}</string>
        <key>KOI_NETWORK_POLICY</key>
        <string>${NET_POLICY_FILE}</string>
        <key>KOI_NETWORK_SOCK</key>
        <string>${NET_SOCK}</string>
EOF
  [ -n "${node_bin}" ] && printf '        <key>KOI_NODE_BIN</key>\n        <string>%s</string>\n' "${node_bin}"
  cat <<EOF
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>${PROXY_LOG_PATH}</string>
    <key>StandardErrorPath</key>
    <string>${PROXY_LOG_PATH}</string>
</dict>
</plist>
EOF
}

install_proxy_service() {
  local node_bin; node_bin="$(stable_node || true)"
  if [ "$OS" = "Darwin" ]; then
    mkdir -p "$LAUNCHD_DIR" "$LAUNCHD_LOG_DIR"
    render_proxy_launchd_plist "$node_bin" > "$PROXY_LAUNCHD_PLIST"
    local user_id; user_id="$(id -u)"
    launchctl bootout "gui/${user_id}/${PROXY_LAUNCHD_LABEL}" 2>/dev/null || true
    if launchctl bootstrap "gui/${user_id}" "$PROXY_LAUNCHD_PLIST" 2>/dev/null ||
       launchctl load -w "$PROXY_LAUNCHD_PLIST" 2>/dev/null; then
      ok "Egress proxy loaded (${PROXY_LAUNCHD_LABEL}) on 127.0.0.1:${PROXY_PORT}"
    else
      err "Failed to load ${PROXY_LAUNCHD_LABEL}"
      return 1
    fi
  else
    have_systemd_user || { wsl_hint; return 1; }
    mkdir -p "$UNIT_DIR"
    render_proxy_systemd_unit "$node_bin" > "$PROXY_UNIT_PATH"
    systemctl --user daemon-reload
    systemctl --user enable "$PROXY_UNIT" >/dev/null 2>&1 || true
    # restart, NOT `enable --now`: if the service is already running, --now is a
    # no-op, so a regenerated unit (new port, new paths) is written to disk and
    # never loaded. That is how the sandbox ends up dialling a port the proxy
    # moved off, and every request comes back "connection refused".
    systemctl --user restart "$PROXY_UNIT" || { err "could not start ${PROXY_SERVICE}"; return 1; }
    sleep 1
    if ! systemctl --user is-active --quiet "$PROXY_UNIT"; then
      err "${PROXY_SERVICE} is not active. Recent log:"
      journalctl --user -u "$PROXY_SERVICE" -n 25 --no-pager >&2 || true
      err "Common causes:"
      err "  shm_open ... File exists  -> a system squid owns the default shared-memory"
      err "                               namespace. Ours passes -n ${PROXY_SERVICE}; if this"
      err "                               squid is too old for -n: sudo systemctl stop squid"
      err "  Cannot bind ... in use    -> something else holds port ${PROXY_PORT};"
      err "                               retry with KOI_PROXY_PORT=<free port>"
      err "  FATAL: ... cache_dir      -> stale ${KOI_HOME_DIR}/squid/koi-squid.conf;"
      err "                               delete it and re-run"
      return 1
    fi
    ok "Egress proxy running (${PROXY_SERVICE}) on 127.0.0.1:${PROXY_PORT}"
  fi
}

remove_proxy_service() {
  if [ "$OS" = "Darwin" ]; then
    local user_id; user_id="$(id -u)"
    launchctl bootout "gui/${user_id}/${PROXY_LAUNCHD_LABEL}" 2>/dev/null || true
    if [ -f "$PROXY_LAUNCHD_PLIST" ]; then
      rm -f "$PROXY_LAUNCHD_PLIST"; ok "Removed ${PROXY_LAUNCHD_PLIST}"
    fi
  else
    if have_systemd_user; then systemctl --user disable --now "$PROXY_UNIT" 2>/dev/null || true; fi
    if [ -f "$PROXY_UNIT_PATH" ]; then
      rm -f "$PROXY_UNIT_PATH"; ok "Removed ${PROXY_UNIT_PATH}"
      have_systemd_user && systemctl --user daemon-reload || true
    fi
  fi
  return 0
}

# Rewrite the gateway's own unit so it carries the (possibly newly chosen)
# proxy port and policy paths. Without this, `network on` picks a free port for
# squid while the gateway keeps handing the sandbox the old one, and every
# request inside the sandbox comes back "connection refused" against a port
# nothing is listening on.
refresh_gateway_unit() {
  local node_bin; node_bin="$(stable_node || true)"
  [ -n "$node_bin" ] || return 0
  if [ "$OS" = "Darwin" ]; then
    [ -f "$LAUNCHD_PLIST" ] || return 0
    render_launchd_plist "$node_bin" > "$LAUNCHD_PLIST"
  else
    [ -f "$UNIT_PATH" ] || return 0
    render_systemd_unit "$node_bin" > "$UNIT_PATH"
    have_systemd_user && systemctl --user daemon-reload || true
  fi
  return 0
}

restart_gateway() {
  if [ "$OS" = "Darwin" ]; then
    local user_id; user_id="$(id -u)"
    launchctl kickstart -k "gui/${user_id}/${LAUNCHD_LABEL}" 2>/dev/null || true
  else
    have_systemd_user && systemctl --user restart "$UNIT" 2>/dev/null || true
  fi
  return 0
}

print_network_status() {
  local mode; mode="$(net_mode)"
  case "$mode" in
    policy)
      ok "Sandbox egress: --net policy (default-deny; unknown hosts prompt you)"
      [ -f "$NET_POLICY_FILE" ] && info "Policy file: ${NET_POLICY_FILE}" ||
        warn "Policy file ${NET_POLICY_FILE} is missing; every request would prompt."
      ;;
    loopback) info "Sandbox egress: --net loopback (no network at all)" ;;
    host)     warn "Sandbox egress: --net host — UNFILTERED. Anything the sandbox runs can reach the internet, and the whole host tree is readable. Enable filtering with: ./koi-gateway-installer network on" ;;
    *)        warn "Sandbox egress: could not read ${CONFIG}" ;;
  esac
}

wsl_hint() {
  warn "No systemd user instance is available."
  if grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
    cat >&2 <<'EOF'
       On WSL2, enable systemd once:
         1. Add to /etc/wsl.conf:      [boot]
                                       systemd=true
         2. From Windows:              wsl --shutdown   (then reopen the distro)
       Then re-run this installer.
EOF
  else
    echo "       This host has no user systemd instance; run the gateway manually with run-gateway.sh." >&2
  fi
}

render_systemd_unit() {
  local node_bin="$1" docs
  docs="$(resolve_abs_path "$DOCS_REL")"
  cat <<EOF
# Generated by koi-gateway-installer on $(date -u +%Y-%m-%dT%H:%M:%SZ). Do not edit;
# re-run the installer to regenerate.
[Unit]
Description=Koi Gateway (WebSocket<->MCP bridge for the Koi Assistant extension)
# Only meaningful when egress filtering is enabled; a missing unit here is
# simply ignored by systemd, so this is safe to emit unconditionally. Without
# it the sandbox server can boot before squid is listening and refuse to start.
Wants=${PROXY_UNIT}
After=${PROXY_UNIT}
Documentation=file://${docs}

[Service]
Type=simple
# gateway-config.json uses relative paths (./sandbox-shell-mcp.mjs, ./lsp_search),
# so the service runs from the gateway directory.
WorkingDirectory=${GATEWAY_DIR}
ExecStart=${WRAPPER}
EOF
  [ -n "${node_bin}" ] && printf 'Environment=KOI_NODE_BIN=%s\n' "${node_bin}"
  [ "${KOI_ALLOW_CREDS:-}" = "1" ] && printf 'Environment=KOI_ALLOW_CREDS=1\n'
  local excl; excl="$(flatten_excludes)"
  [ -n "${excl}" ] && printf 'Environment=KOI_SANDBOX_EXCLUDE=%s\n' "${excl}"
  # Both halves of the approval path must agree on these paths or the sandbox
  # server opens a broker socket the policy helper never finds, and every
  # prompt silently becomes a denial.
  printf 'Environment=KOI_HOME=%s\n' "${KOI_HOME_DIR}"
  printf 'Environment=KOI_NETWORK_POLICY=%s\n' "${NET_POLICY_FILE}"
  printf 'Environment=KOI_NETWORK_SOCK=%s\n' "${NET_SOCK}"
  printf 'Environment=KOI_PROXY_PORT=%s\n' "${PROXY_PORT}"
  cat <<'EOF'
Restart=on-failure
RestartSec=3
# First start runs the lsp_search autoBuild — allow time.
TimeoutStartSec=600
SyslogIdentifier=koi-gateway

[Install]
WantedBy=default.target
EOF
}

render_launchd_plist() {
  local node_bin="$1"
  local excl; excl="$(flatten_excludes)"
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LAUNCHD_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${WRAPPER}</string>
    </array>
    <key>WorkingDirectory</key>
    <string>${GATEWAY_DIR}</string>
    <key>EnvironmentVariables</key>
    <dict>
EOF
  [ -n "${node_bin}" ] && printf '        <key>KOI_NODE_BIN</key>\n        <string>%s</string>\n' "${node_bin}"
  [ "${KOI_ALLOW_CREDS:-}" = "1" ] && printf '        <key>KOI_ALLOW_CREDS</key>\n        <string>1</string>\n'
  [ -n "${excl}" ] && printf '        <key>KOI_SANDBOX_EXCLUDE</key>\n        <string>%s</string>\n' "${excl}"
  # Must match render_proxy_launchd_plist; see the systemd unit for why.
  printf '        <key>KOI_HOME</key>\n        <string>%s</string>\n' "${KOI_HOME_DIR}"
  printf '        <key>KOI_NETWORK_POLICY</key>\n        <string>%s</string>\n' "${NET_POLICY_FILE}"
  printf '        <key>KOI_NETWORK_SOCK</key>\n        <string>%s</string>\n' "${NET_SOCK}"
  printf '        <key>KOI_PROXY_PORT</key>\n        <string>%s</string>\n' "${PROXY_PORT}"
  cat <<EOF
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>${LAUNCHD_LOG_PATH}</string>
    <key>StandardErrorPath</key>
    <string>${LAUNCHD_LOG_PATH}</string>
</dict>
</plist>
EOF
}

print_exclude_status() {
  local excl n; excl="$(flatten_excludes)"; n="$(exclude_count "$excl")"
  if [ -n "$excl" ]; then
    if [ -n "${KOI_SANDBOX_EXCLUDE:-}" ]; then
      ok "Credential masking: ${n} path(s) from \$KOI_SANDBOX_EXCLUDE"
    else
      ok "Credential masking: ${n} path(s) from $(basename "$EXCLUDE_FILE")"
    fi
  else
    warn "No exclude list found at ${EXCLUDE_FILE} — the sandbox will mask NOTHING."
    warn "Host secrets would be readable by the LLM session."
  fi
  if [ "${KOI_ALLOW_CREDS:-}" = "1" ]; then
    warn "KOI_ALLOW_CREDS=1 is set — host credentials are deliberately exposed to the sandbox."
  fi
}

# --- commands ---------------------------------------------------------------

cmd_render() {
  local node_bin; node_bin="$(stable_node || true)"
  if [ "$OS" = "Darwin" ]; then
    render_launchd_plist "$node_bin"
  else
    render_systemd_unit "$node_bin"
  fi
}

cmd_install_macos() {
  if ! have_launchd; then
    err "launchctl not found on this macOS system."
    exit 1
  fi

  local node_bin; node_bin="$(stable_node || true)"
  if [ -n "$node_bin" ]; then
    ok "Node: ${node_bin}"
  else
    warn "Could not find a stable Node path. run-gateway.sh will retry at runtime;"
    warn "if start fails, re-run: KOI_NODE_BIN=\$(which node) ./koi-gateway-installer"
  fi

  ensure_deps "$node_bin" || exit 1

  mkdir -p "$LAUNCHD_DIR" "$LAUNCHD_LOG_DIR"
  render_launchd_plist "$node_bin" > "$LAUNCHD_PLIST"
  ok "Wrote ${LAUNCHD_PLIST}"

  print_exclude_status
  print_network_status

  # Unload old instance if running
  local user_id; user_id="$(id -u)"
  launchctl bootout "gui/${user_id}/${LAUNCHD_LABEL}" 2>/dev/null || launchctl unload "$LAUNCHD_PLIST" 2>/dev/null || true

  # Load new service
  if launchctl bootstrap "gui/${user_id}" "$LAUNCHD_PLIST" 2>/dev/null || launchctl load -w "$LAUNCHD_PLIST" 2>/dev/null; then
    ok "Loaded LaunchAgent ${LAUNCHD_LABEL}"
  else
    err "Failed to load LaunchAgent via launchctl"
    exit 1
  fi

  sleep 1
  echo
  ok "Gateway service is configured and loaded via launchd."
  info "Manage it with:"
  echo "    launchctl list | grep ${LAUNCHD_LABEL}       # check status"
  echo "    tail -f ~/Library/Logs/koi-gateway.log       # follow logs"
  echo "    ./koi-gateway-installer uninstall            # stop and remove LaunchAgent"
}

cmd_install_linux() {
  if ! have_systemd_user; then wsl_hint; exit 1; fi

  local node_bin; node_bin="$(stable_node || true)"
  if [ -n "$node_bin" ]; then
    ok "Node: ${node_bin}"
  else
    warn "Could not find a stable Node path. run-gateway.sh will retry at runtime;"
    warn "if start fails, re-run: KOI_NODE_BIN=\$(which node) ./koi-gateway-installer"
  fi

  ensure_deps "$node_bin" || exit 1

  mkdir -p "$UNIT_DIR"
  render_systemd_unit "$node_bin" > "$UNIT_PATH"
  ok "Wrote ${UNIT_PATH}"

  print_exclude_status
  print_network_status

  systemctl --user daemon-reload
  ok "Reloaded user systemd"

  if command -v loginctl >/dev/null 2>&1; then
    local login_user="${USER:-$(id -un)}"
    if loginctl enable-linger "$login_user" 2>/dev/null; then
      ok "Lingering enabled (runs without an active login)"
    else
      warn "Could not enable lingering (loginctl enable-linger $login_user); the service will start on your next login."
    fi
  fi

  if systemctl --user enable --now "$UNIT"; then
    ok "Enabled + started ${SERVICE_NAME}"
  else
    err "enable/start failed — inspect: systemctl --user status ${SERVICE_NAME}"
    exit 1
  fi

  sleep 1
  systemctl --user reset-failed "$UNIT" 2>/dev/null || true
  if ! systemctl --user is-active --quiet "$UNIT"; then
    err "${SERVICE_NAME} is not active. Recent log:"
    journalctl --user -u "$SERVICE_NAME" -n 25 --no-pager >&2 || true
    exit 1
  fi

  echo
  info "Gateway is running. Manage it with:"
  echo "    systemctl --user status ${SERVICE_NAME}"
  echo "    systemctl --user restart ${SERVICE_NAME}     # guaranteed clean slate"
  echo "    journalctl --user -u ${SERVICE_NAME} -f      # follow logs"
  echo "    ./koi-gateway-installer uninstall            # remove the service"
}

cmd_install() {
  [ -f "$ENTRY" ]   || { err "koi-gateway.js not found at ${ENTRY} — run this from the gateway dir."; exit 1; }
  [ -f "$WRAPPER" ] || { err "run-gateway.sh not found at ${WRAPPER}."; exit 1; }
  [ -f "$CONFIG" ]  || warn "gateway-config.json not found at ${CONFIG}; the gateway needs it at runtime."
  chmod +x "$WRAPPER" 2>/dev/null || true

  if [ "$OS" = "Darwin" ]; then
    cmd_install_macos
  else
    cmd_install_linux
  fi
}

cmd_uninstall() {
  remove_proxy_service
  if [ "$OS" = "Darwin" ]; then
    local user_id; user_id="$(id -u)"
    launchctl bootout "gui/${user_id}/${LAUNCHD_LABEL}" 2>/dev/null || launchctl unload "$LAUNCHD_PLIST" 2>/dev/null || true
    if [ -f "$LAUNCHD_PLIST" ]; then
      rm -f "$LAUNCHD_PLIST"
      ok "Removed ${LAUNCHD_PLIST}"
    else
      info "No LaunchAgent installed at ${LAUNCHD_PLIST}"
    fi
  else
    if have_systemd_user; then
      systemctl --user disable --now "$UNIT" 2>/dev/null || true
    fi
    if [ -f "$UNIT_PATH" ]; then
      rm -f "$UNIT_PATH"
      ok "Removed ${UNIT_PATH}"
      have_systemd_user && systemctl --user daemon-reload || true
    else
      info "No unit installed at ${UNIT_PATH}"
    fi
  fi
}

# Turn sandbox egress filtering on or off end to end: preflight the enforcement
# tools, seed the policy, start the proxy service, and point the sandbox server
# at it. Split out from `install` because it depends on packages (pasta / nft /
# squid) the base gateway does not need — forcing that on every install would
# make the gateway unusable on a host that lacks them.
cmd_network() {
  local action="${1:-status}"
  case "$action" in
    status)
      print_network_status
      echo
      info "Enforcement tools:"
      net_preflight || true
      if [ -f "$NET_POLICY_FILE" ]; then
        echo
        info "Policy (${NET_POLICY_FILE}):"
        local node_bin; node_bin="$(stable_node || command -v node || true)"
        [ -n "$node_bin" ] && "$node_bin" --input-type=module -e '
          const [lib, file] = process.argv.slice(1);
          const { loadPolicy } = await import("file://" + lib);
          const p = loadPolicy(file);
          const fmt = (r) => (r.ports && r.ports.length ? `${r.host}:${r.ports.join(",")}` : r.host);
          const a = p.rules.filter((r) => r.decision === "allow");
          const d = p.rules.filter((r) => r.decision === "deny");
          console.log(`  unmatched hosts: ${p.default}`);
          console.log(`  allowed (${a.length}): ${a.map(fmt).join(", ") || "none"}`);
          console.log(`  denied  (${d.length}): ${d.map(fmt).join(", ") || "none"}`);
        ' "$NET_POLICY_LIB" "$NET_POLICY_FILE" </dev/null || true
      fi
      ;;
    on|enable)
      info "Checking dependencies ..."
      if ! net_preflight; then
        # Do not make the user decode a list and find their own package manager.
        net_install_deps || exit 1
        net_pick_port
        info "Re-checking ..."
        net_preflight || { err "Still missing dependencies; see above."; exit 1; }
      fi
      net_pick_port

      seed_network_policy || exit 1
      install_proxy_service || exit 1
      if ! net_verify; then
        err "The proxy is not usable, so egress filtering has NOT been enabled."
        err "gateway-config.json is unchanged; the sandbox keeps working as before."
        exit 1
      fi

      set_net_mode policy || exit 1
      ok "gateway-config.json now starts the sandbox with --net policy"
      refresh_gateway_unit
      restart_gateway
      sleep 1
      echo
      print_network_status
      echo
      info "Verify it:"
      info "  node ${GATEWAY_DIR}/test-network-approval.mjs        (no browser needed)"
      info "  /skill sandbox-shell/scripts/network-policy-test.js  (in the Koi side panel)"
      ;;
    off|disable)
      set_net_mode host || exit 1
      remove_proxy_service
      refresh_gateway_unit
      restart_gateway
      warn "Sandbox egress is UNFILTERED again (--net host). ${NET_POLICY_FILE} is kept for next time."
      ;;
    preflight)
      net_preflight
      ;;
    *)
      err "Unknown network subcommand: ${action} (expected: status | on | off | preflight)"
      exit 2
      ;;
  esac
}

cmd_status() {
  if [ "$OS" = "Darwin" ]; then
    if [ ! -f "$LAUNCHD_PLIST" ]; then
      info "Not installed. Run: ./koi-gateway-installer"
      exit 0
    fi
    info "LaunchAgent: ${LAUNCHD_PLIST}"
    if have_launchd; then
      local user_id; user_id="$(id -u)"
      launchctl list | grep "${LAUNCHD_LABEL}" || launchctl print "gui/${user_id}/${LAUNCHD_LABEL}" 2>/dev/null || info "Service is stopped/unloaded."
    fi
    if [ -f "$LAUNCHD_LOG_PATH" ]; then
      echo
      info "Recent logs (${LAUNCHD_LOG_PATH}):"
      tail -n 15 "$LAUNCHD_LOG_PATH" || true
    fi
  else
    if ! have_systemd_user; then wsl_hint; exit 1; fi
    [ -f "$UNIT_PATH" ] || { info "Not installed. Run: ./koi-gateway-installer"; exit 0; }
    systemctl --user status "$UNIT" --no-pager || true
  fi
}

cmd_deps() {
  ensure_deps "$(stable_node || true)"
}

cmd_excludes() {
  local excl; excl="$(flatten_excludes)"
  if [ -z "$excl" ]; then
    warn "No exclude list (${EXCLUDE_FILE} missing/empty) — nothing would be masked."
    return 0
  fi
  local src="${EXCLUDE_FILE}"
  [ -n "${KOI_SANDBOX_EXCLUDE:-}" ] && src='$KOI_SANDBOX_EXCLUDE'
  info "$(exclude_count "$excl") path(s) from ${src}:"
  printf '%s' "$excl" | tr ',' '\n' | sed 's/^/  /'
}

usage() {
  cat <<EOHELP
koi-gateway-installer — run the Koi Gateway as a background service (systemd on Linux, launchd on macOS).

Usage: ./koi-gateway-installer [command]

Commands:
  install     (default) resolve paths + Node, configure service, enable + start it
  uninstall   stop, disable, and remove the service
  status      show service status
  deps        install the gateway's dependencies (ws); touches no service unit
  render      print the service configuration that would be installed (dry run)
  excludes    print the credential paths that would be masked (dry run)
  network     sandbox egress filtering:
                network status     (default) current mode, tools, and policy
                network on         preflight, seed policy, start proxy, switch
                                   the sandbox to --net policy, restart gateway
                network off        back to --net host, stop the proxy
                network preflight  just check for pasta / nft / squid
  -h, --help  this help

Env:
  KOI_NODE_BIN=/abs/path/to/node   force a specific Node (else auto-detected)
  KOI_ALLOW_CREDS=1                allow the sandbox to access host credentials
  KOI_EXCLUDE_FILE=/abs/path       use a different exclude list (default: sandbox-exclude.default)
  KOI_SANDBOX_EXCLUDE="a,b,c"      use this list verbatim instead of the file
  KOI_NETWORK_ALLOW=/abs/path      seed allowlist (default: koi-network-allow.default)
  KOI_NETWORK_POLICY=/abs/path     policy file (default: ~/.koi/network-policy.json)
  KOI_PROXY_PORT=3128              egress proxy port

Sandbox egress filtering ('network on'):
  Off by default. When enabled, the sandbox gets its own network namespace
  (pasta), a default-drop nftables filter, and an egress proxy (squid) that
  consults ~/.koi/network-policy.json. Hosts on the allowlist go straight
  through; anything else prompts you in the Koi side panel, and your answer can
  be persisted back into the policy. Needs pasta, nftables and squid on Linux
  (squid only on macOS); 'network preflight' tells you what is missing.

Credential masking:
  The sandbox server has NO built-in credential list — it masks exactly what it
  is given. This installer flattens sandbox-exclude.default into the service as
  Environment=KOI_SANDBOX_EXCLUDE. Edit that file and re-run the installer to
  change the policy; check the result with './koi-gateway-installer excludes'.
EOHELP
}

case "${1:-install}" in
  install|upgrade) cmd_install ;;
  uninstall|remove) cmd_uninstall ;;
  status) cmd_status ;;
  deps|deps-install) cmd_deps ;;
  render|print) cmd_render ;;
  excludes|exclude) cmd_excludes ;;
  network|net) shift || true; cmd_network "${1:-status}" ;;
  -h|--help|help) usage ;;
  *) err "Unknown command: $1"; echo; usage; exit 2 ;;
esac
